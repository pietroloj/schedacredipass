# Copia in .env. Non inviare questo file quando contiene segreti.
HUB_AUTH=local
HUB_STORE=sqlite
PORT=8765
# Progetto rilevato nella Scheda Consulenza: consulenza-credipass.
# In modalità Firebase impostare entrambi i campi sotto e HUB_AUTH=firebase.
FIREBASE_PROJECT_ID=consulenza-credipass
FIREBASE_WEB_API_KEY=AIzaSyDDRWJpEhFb2zBB9MlkbEel_9cXOTTKBJ4
FIREBASE_STORAGE_BUCKET=consulenza-credipass.firebasestorage.app
# Percorso assoluto del JSON di servizio, SOLO sul server.
GOOGLE_APPLICATION_CREDENTIALS=
# Per cloud usare HUB_STORE=firestore e una chiave persistente Fernet.
HUB_MASTER_KEY=
PUBLIC_BASE_URL=
# HOST=0.0.0.0 solo dietro un proxy HTTPS in modalità Firebase.
HOST=127.0.0.1
# Alternativa alla chiave cifrata salvata dall'interfaccia:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-1.5
AI_DAILY_PLANS=5
AI_DAILY_IMAGES=10
META_GRAPH_VERSION=v23.0
LINKEDIN_VERSION=202605
CREDIPASS_NO_BROWSER=0
# Bootstrap solo se non si usa il ruolo admin della collezione consulenti.
FIREBASE_ADMIN_UIDS=
